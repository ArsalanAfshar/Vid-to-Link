# ===========================================================================
# Vid-to-Link Configuration Environment Variables
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. MANDATORY TELEGRAM CREDENTIALS
# ---------------------------------------------------------------------------
# Telegram API credentials obtained from https://my.telegram.org:
API_ID=12345678
API_HASH=abcdef0123456789abcdef0123456789

# Telegram Bot Token obtained from @BotFather:
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram Numeric User ID of the bot owner (get from @userinfobot):
OWNER_ID=123456789

# ---------------------------------------------------------------------------
# 2. RAILWAY NETWORKING & DIRECT DOWNLOAD LINKS
# ---------------------------------------------------------------------------
# Port for the integrated HTTP direct-download file server (default: 8080).
# On Railway, this is automatically provided by Railway's $PORT.
PORT=8080

# Public Base URL for generated download links.
# Example: https://vid-to-link-production.up.railway.app
# If left blank, Vid-to-Link automatically detects Railway's public domain
# (via RAILWAY_PUBLIC_DOMAIN / RAILWAY_STATIC_URL) or defaults to http://localhost:8080.
BASE_URL=

# ---------------------------------------------------------------------------
# 3. FILE RETENTION & EXPIRATION (ADMIN-CONFIGURABLE)
# ---------------------------------------------------------------------------
# Default duration in seconds that downloaded files remain available before
# automatic deletion. Default is 7200 seconds (2 hours).
# The owner can change this at runtime directly in Telegram (/expiration) without
# code changes or redeploying.
FILE_EXPIRATION_SECONDS=7200

# Directory where downloaded media is kept while unexpired.
# On Railway Free Plan, /tmp/downloads uses container ephemeral storage.
# If you attach a Railway Volume, you can set this to /data/downloads.
DOWNLOAD_PATH=/tmp/downloads

# SQLite database file path.
DB_PATH=bot_data.db

# ---------------------------------------------------------------------------
# 4. LARGE FILE SUPPORT & RESOURCE LIMITS (RAILWAY FREE TIER)
# ---------------------------------------------------------------------------
# Maximum file size allowed in bytes (default: 10 GB = 10737418240).
# Telegram's 2GB bot upload limit does NOT apply here because files are
# delivered directly over HTTP. Set to 0 for unlimited (disk bounded).
MAX_FILE_SIZE=10737418240

# Maximum simultaneous downloads (default: 2).
# Keeps RAM and CPU usage low within Railway Free Plan limits (512MB RAM).
MAX_CONCURRENT_DOWNLOADS=2

# Per-user rate limiting: max downloads allowed within the time window.
RATE_LIMIT_COUNT=5
RATE_LIMIT_WINDOW=60

# Anti-spam cooldown system:
COOLDOWN_ENABLED=false
COOLDOWN_COUNT=5
COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------
# 5. DEDICATED MANAGER BOT (OPTIONAL)
# ---------------------------------------------------------------------------
# Optional second bot token for admin management and live reporting.
# (If not set, the bot owner can access all admin features directly in the
# main bot via /admin, /expiration, /storage, /limits).
MANAGER_BOT_TOKEN=
MANAGER_ENABLED=false
MANAGER_ADMIN_IDS=
MANAGER_CHAT_ID=

# ---------------------------------------------------------------------------
# 6. PLATFORM FEATURE TOGGLES
# ---------------------------------------------------------------------------
PORNHUB_ENABLED=true
PORNHUB_NOTIFY_ADMIN=true
PINTEREST_ENABLED=true
INSTAGRAM_ENABLED=true
TWITTER_ENABLED=true

# ---------------------------------------------------------------------------
# 7. YOUTUBE BOT BYPASS & COOKIES (NETSCAPE FORMAT)
# ---------------------------------------------------------------------------
# Datacenter/cloud hosts like Railway trigger YouTube's "Sign in to confirm
# you're not a bot" challenge when unauthenticated.
#
# THREE WAYS TO PROVIDE COOKIES:
# 1. (Easiest) Send cookies.txt directly to your Telegram bot as the owner.
#    The bot automatically parses, validates, and activates them instantly!
# 2. Base64 environment variable (RECOMMENDED for Railway dashboard):
#    Export cookies with browser extension "Get cookies.txt LOCALLY", then:
#    base64 -w 0 cookies.txt
#    and paste into YOUTUBE_COOKIES_B64 below (immune to newline/tab mangling).
# 3. Paste raw Netscape cookies into YOUTUBE_COOKIES.
YOUTUBE_COOKIES_B64=
YOUTUBE_COOKIES=
YOUTUBE_COOKIES_FILE=
COOKIES_FILE=
COOKIES_B64=
INSTAGRAM_COOKIES=
EXTRA_COOKIES=

# Optional Proxy (HTTP/SOCKS5) to route YouTube traffic through a residential IP:
# Example: socks5://user:pass@proxy.example.com:1080
YOUTUBE_PROXY=
DOWNLOADER_PROXY=

# Optional manual Proof-of-Origin (PO) Token and Visitor Data:
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=

# Optional YouTube player client override (comma-separated):
# Defaults to: tv_simply,tv_downgraded,android_vr,web_embedded,tv,mweb,ios
# YOUTUBE_PLAYER_CLIENTS=tv_simply,android_vr

# ---------------------------------------------------------------------------
# 8. LOGGING
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
